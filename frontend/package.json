    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.83.0",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
